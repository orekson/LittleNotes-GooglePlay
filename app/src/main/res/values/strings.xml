<resources>
    <string name="app_name">小小筆記</string>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#7954B3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="DigitalTimePickerDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#7954B3</item>
        <item name="android:timePickerStyle">@style/DigitalTimePicker</item>
    </style>
    <style name="DigitalTimePicker" parent="android:style/Widget.Material.TimePicker">
        <item name="android:timePickerMode">spinner</item>
    </style>
    <style name="TabPageTheme" parent="AppTheme">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
